# StayEg v1.2 - Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================

# ── Supabase Configuration ──────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# ── Admin Configuration ─────────────────────────────────────
# Secret key for admin/setup/seed endpoints (REQUIRED)
# Generate with: openssl rand -base64 32
ADMIN_SECRET=your-secure-admin-secret

# ── JWT Configuration ───────────────────────────────────────
# Secret key for signing JWT tokens (REQUIRED — auth breaks without this)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# ── App Configuration ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://stayeg.in
NEXT_PUBLIC_APP_NAME=StayEg

# ── OTP Configuration ───────────────────────────────────────
# Pre-defined OTPs for development/testing (comma-separated)
# ⚠️  CRITICAL: In production, this MUST be empty! Do NOT set predefined OTPs.
# Leaving predefined OTPs in production allows anyone to bypass real SMS verification.
PREDEFINED_OTPS=

# ── Razorpay Payments (Optional) ────────────────────────────
# Leave empty for simulated payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email Service — Resend (Optional) ───────────────────────
# Get from: https://resend.com → API Keys
# Leave empty for console-log-only mode
RESEND_API_KEY=

# ── SMS Service — MSG91 (Optional) ─────────────────────────
# Get from: https://msg91.com → API Keys
# Leave empty for simulated SMS mode
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Sentry Error Monitoring (Optional) ──────────────────────
# Create account at: https://sentry.io → Create Next.js project → Copy DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production

# ── Development Notes ───────────────────────────────────────
# - All variables marked (Optional) can be left empty for dev mode
# - All variables marked (REQUIRED) must be set or the app will fail
# - Never commit .env to version control
# - For Vercel deployment, set all variables in Project → Settings → Environment Variables
